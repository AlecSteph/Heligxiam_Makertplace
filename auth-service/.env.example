# Configuration de la base de données
DB_HOST=localhost
DB_PORT=5432
DB_NAME=heligxiam_marketplace
DB_USER=postgres
DB_PASSWORD=password

# MySQL (schéma heligxiam_marketplace_core_mysql.sql)
# Si défini : inscription/connexion VENDEUR en base (comptes_vendeur, boutiques…),
# API /api/seller (JWT obligatoire), documents KYC + messagerie opérateur.
# Sans MYSQL_HOST : vendeur reste en mémoire (démo) ; /api/seller renvoie 503.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=python
MYSQL_DATABASE=heligxiam_marketplace

# MongoDB (observabilité NoSQL du dashboard vendeur)
# Optionnel : snapshots dashboard, audit visuel, historique KPI
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=heligxiam_observability

# JWT
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_random
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_make_it_long_and_random

# Serveur
PORT=3001
NODE_ENV=development

# Sécurité
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Console admin (JWT /api/admin)
ADMIN_EMAIL=admin@heligxiam.com
ADMIN_PASSWORD=Heligxiam2026!