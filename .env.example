# Example environment file for Heligxiam auth service

# ------------------------
# Server & environment
# ------------------------
PORT=3001
NODE_ENV=development

# ------------------------
# Database (PostgreSQL)
# ------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=heligxiam
DB_USER=postgres
DB_PASSWORD=your_password_here

# ------------------------
# JWT configuration
# ------------------------
# Generate a strong random string: 
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------
# Proof of Work
# ------------------------
POW_DIFFICULTY=4

# ------------------------
# Password hashing
# ------------------------
BCRYPT_ROUNDS=12

# ------------------------
# Pepper (valeur secrète globale)
# ------------------------
# Cette chaîne est pré‑fixée au mot de passe avant le hash bcrypt.
# Elle doit être stockée en dehors du code et changée en production.
PEPPER=your_pepper_here

# ------------------------
# Rate limiting
# ------------------------
RATE_WINDOW_MS=900000            # 15 minutes
RATE_MAX=1000                    # 1000 requests
AUTH_RATE_WINDOW_MS=900000       # 15 minutes for auth endpoints
AUTH_RATE_MAX=5                  # 5 login attempts

# ------------------------
# CORS
# ------------------------
ALLOWED_ORIGINS=http://localhost:4200

# ------------------------
# Logging
# ------------------------
LOG_LEVEL=info
LOG_FILE=logs/auth.log

# ------------------------
# Optional extras
# ------------------------
# SENTRY_DSN=
# NEW_RELIC_LICENSE_KEY=

# Other settings can be added as needed.
